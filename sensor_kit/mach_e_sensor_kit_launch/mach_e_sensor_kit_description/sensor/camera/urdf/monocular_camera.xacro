<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="monocular_camera_macro"
               params="name parent namespace x y z roll pitch yaw fps width height fov">

    <xacro:property name="sensor_box" value="0.05"/>
    <xacro:property name="mass" value="0.1"/>

    <!-- camera link -->
    <joint name="${name}_joint" type="fixed">
      <origin
        xyz="${x} ${y} ${z}"
        rpy="${roll} ${pitch} ${yaw}"/>

      <parent link="${parent}"/>
      <child link="${name}/camera_link"/>
    </joint>


    <link name="${name}/camera_link">

      <visual>
        <geometry>
          <box size="${sensor_box} ${sensor_box} ${sensor_box}"/>
        </geometry>

        <origin xyz="0 0 0" rpy="0 0 0"/>

        <material name="red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>


      <inertial>

        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="${mass}"/>

        <inertia
          ixx="${(sensor_box*sensor_box+sensor_box*sensor_box)*mass/12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(sensor_box*sensor_box+sensor_box*sensor_box)*mass/12.0}"
          iyz="0.0"
          izz="${(sensor_box*sensor_box+sensor_box*sensor_box)*mass/12.0}"/>

      </inertial>


      <collision>

        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <box size="${sensor_box} ${sensor_box} ${sensor_box}"/>
        </geometry>

      </collision>

    </link>

    <!-- optical link, REP-103 optical convention (x right, y down, z forward).
         Image/CameraInfo headers must carry this frame rather than the body link,
         because the projection nodes treat the header frame z axis as depth.
         Keep colons out of these comments, the URDF is YAML-parsed as a parameter. -->
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="${name}/camera_link"/>
      <child link="${name}/camera_optical_link"/>
    </joint>

    <link name="${name}/camera_optical_link"/>

  </xacro:macro>


</robot>
